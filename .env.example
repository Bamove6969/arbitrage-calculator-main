# Copy this file to `.env` and fill in the 4 SECRETS marked below.
# Everything else has a working default — no edits needed.
#
# First-time-only setup (after `docker compose up`):
#   1. Approve the IBKey 2FA push on your phone within 2 minutes
#   2. One-time Ollama Cloud signin:
#        docker exec arbitrage-universal ollama signin
#      (auth is saved to ./data/ollama/ and survives rebuilds)
#   3. Seed Colab cookies once: visit http://localhost:5000/colab-setup
#      from your phone and paste the Cookie-Editor export

# ====================================================================
# SECRETS — you MUST fill these in
# ====================================================================

# IBKR account password
IB_PASSWORD=change-me

# ngrok auth token (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=your-token-here

# Your reserved ngrok domain
NGROK_DOMAIN=copyrightable-pseudocartilaginous-sade.ngrok-free.dev

# GitHub Personal Access Token with `gist` scope
# (https://github.com/settings/tokens/new?scopes=gist)
GITHUB_TOKEN=your-token-here

# ====================================================================
# Defaults — leave as-is unless you know you need to change them
# ====================================================================

# --- IBKR ---
IB_USERNAME=fiend6969
IB_REGION=America
IB_TIMEZONE=America/Vancouver
IB_LOGINTAB=IB API
IB_LOGINTYPE=Live Trading
IB_PREFER_IBKEY=true
IBGA_WAIT_TIMEOUT=600

# --- LLM / Ollama Cloud ---
# Cloud-hosted Gemma via Ollama Cloud (no API key — uses `ollama signin` auth)
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_MODELS=                       # empty = no local pulls, cloud only
OLLAMA_NUM_PARALLEL=2                # 2 workers per loaded instance
OLLAMA_MAX_LOADED_MODELS=2           # 2 instances = 4 concurrent gens total

# --- Universal entrypoint tuning ---
TWO_FA_WINDOW=120
MAX_2FA_RETRIES=5
LOG_LEVEL=INFO

# ====================================================================
# Optional — only fill in if you need them
# ====================================================================

# Google OAuth for service-account Colab flow (not needed if using Playwright cookies)
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# COLAB_NOTEBOOK_DRIVE_ID=

# Robinhood (only if you wire Robinhood into the matcher later)
# ROBINHOOD_CLIENT_ID=
# ROBINHOOD_PRIVATE_KEY=

# OpenRouter is no longer used — leave OPENROUTER_API_KEY unset
